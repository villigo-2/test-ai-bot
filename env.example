# Required: Telegram Bot Configuration
BOT_TOKEN="your_bot_token_here"  # Get from @BotFather on Telegram

# Required: OpenRouter API Configuration for LLM responses
OPENROUTER_API_KEY="your_openrouter_key"    # Get from https://openrouter.ai/
OPENROUTER_MODEL="gpt-4o-mini"              # Model to use for analysis summaries
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"  # OpenRouter API endpoint

# Optional: For local development with webhooks (e.g., using ngrok)
WEBHOOK_URL=""  # Leave empty for polling mode, set for webhook mode

# Optional: Google Cloud Run deployment configuration
GCP_PROJECT_ID="umico-client"        # Your Google Cloud Project ID
GCP_REGION="europe-west1"            # Cloud Run region
GCP_SERVICE_NAME="test-telegram-bot" # Cloud Run service name

# Optional: LLM sampling rate for audit logs (0.0 to 1.0)
LLM_SAMPLE_RATE="0.1"  # 10% of requests will be logged for review
